# 사이트 주소 (끝에 / 없이). Render에서는 비워두면 자동으로 채워져요.
BASE_URL=https://tteongnip-gg.onrender.com

# 로그인 쿠키와 수집기 키를 만드는 비밀값. 아무도 모르는 긴 문자열로 정하고 바꾸지 마세요.
# 바꾸면 모두 다시 로그인해야 하고, 수집기도 다시 받아야 해요.
SESSION_SECRET=

# 무료 Postgres 주소 (예: Neon). 비워두면 data/tteongnip.db 파일(SQLite)에 저장해요.
DATABASE_URL=

# 디스코드 로그인 (우리 서버 멤버만 보기)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# 내전 결과를 올릴 디스코드 채널 웹후크 주소 (선택)
DISCORD_WEBHOOK_URL=

# 관리자 디스코드 사용자 ID, 쉼표로 여러 명 (내전 숨기기, 계정 연결 정리)
ADMIN_DISCORD_IDS=

# 몇 판부터 순위에 올릴지 (기본 5)
MIN_RANKED_GAMES=5

# 기록할 모드: CLASSIC(소환사의 협곡), ARAM(칼바람). 여러 개면 쉼표로.
ALLOWED_MODES=CLASSIC

# 기록할 최소 인원 (기본 10 = 5대5)
MIN_PLAYERS=10

# 이보다 짧은 게임은 기록 안 함 (초, 기본 300 = 5분)
MIN_GAME_SECONDS=300

# 오버워치: 최소 인원(끝까지 남은 사람 기준, 기본 8)과 최소 경기 시간(초, 기본 180)
OW_MIN_PLAYERS=8
OW_MIN_GAME_SECONDS=180

# 모두가 같은 키를 쓰고 싶을 때만 (보통은 비워두고 멤버별 키 사용)
UPLOAD_KEY=

SITE_NAME=떡잎.gg
SITE_TIMEZONE=Asia/Seoul
